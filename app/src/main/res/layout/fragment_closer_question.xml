<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="viewmodel"
            type="com.ubcompany.umbba_android.presentation.mypage.GetCloserViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_grey300_fill_r17_rect"
            android:minHeight="380dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="26dp"
                android:textAppearance="@style/AndroidSubHead1SemiBold20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Q.겨울에는.." />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:chipSpacingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_question"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_answer1"
                    style="@style/CloserChoiceChipStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="@={viewmodel.isCheckedAnswerOne}"
                    android:minHeight="136dp"
                    android:textAppearance="@style/AndroidSubHead1SemiBold20"
                    app:chipMinTouchTargetSize="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_answer2"
                    style="@style/CloserChoiceChipStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="@={viewmodel.isCheckedAnswerTwo}"
                    android:minHeight="136dp"
                    android:textAppearance="@style/AndroidSubHead1SemiBold20"
                    app:chipMinTouchTargetSize="0dp" />

            </com.google.android.material.chip.ChipGroup>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_check_result"
            style="@style/AndroidBody1_1SemiBold16"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="94dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/sel_btn_next"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="결과 확인하기"
            android:textColor="@color/white_500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_question" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>